<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tech_inventory" model="ir.module.category">
        <field name="name">Inventario Tech</field>
        <field name="description">Categoría para gestión de equipos tecnológicos</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_tech_user" model="res.groups">
        <field name="name">Usuario IT</field>
        <field name="category_id" ref="module_category_tech_inventory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_tech_valorador" model="res.groups">
        <field name="name">Valorador</field>
        <field name="category_id" ref="module_category_tech_inventory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_tech_manager" model="res.groups">
        <field name="name">Gerente IT</field>
        <field name="category_id" ref="module_category_tech_inventory"/> 
        <field name="implied_ids" eval="[(4, ref('group_tech_user'))]"/> 
    </record>

</odoo>